#compdef launchctl

__launchctl_cmds() {
  reply=(
    'bootstrap:bootstrap a domain or a service into a domain'
    'bootout:tear down a domain or remove a service from a domain'
    'enable:enable an existing service'
    'disable:disable an existing service'
    'kickstart:force an existing service to start'
    "attach:attach the system's debugger to a service"
    'debug:configure the next invocation of a service for debugging'
    'kill:send a signal to the service instance'
    'blame:print the reason a service is running'
    'print:print a description of a domain or service'
    'print-cache:print information about the service cache'
    'print-disabled:print which services are disabled'
    'print-token:print service identifier given an xpc event token'
    'plist:print a property list embedded in a binary'
    'procinfo:print port information about a process'
    'hostinfo:print port information about the host'
    'resolveport:resolve a port name from a process to an endpoint'
    "limit:read or modify launchd's resource limits"
    'examine:run an analysis tool against launchd'
    'config:modify persistent configuration parameters'
    'dumpstate:dump launchd state to stdout'
    'dump-xsc:dump launchd XPC string caches to stdout'
    'dumpjpcategory:dump the jetsam properties category for all services'
    'reboot:initiate a system reboot of the specified type'
    'bootshell:bring the system up from single-user mode'
    'load:bootstrap a service or directory of services (legacy)'
    'unload:unload a service or directory of services (legacy)'
    'remove:unload the specified service name (legacy)'
    'list:list information about services (legacy)'
    'start:start the specified service (legacy)'
    'stop:stop the specified service if it is running (legacy)'
    'setenv:set environment variables for all services in the domain'
    'unsetenv:unset environment variables for all services in the domain'
    'getenv:get the value of an environment variable from launchd'
    "bsexec:execute a program in another process' bootstrap context"
    'asuser:execute a program in the bootstrap context of a given user'
    'reload-atf:reload the active trial factors'
    'submit:submit a basic job from the command line (legacy)'
    'managerpid:print the PID of the launchd controlling the session'
    'manageruid:print the UID of the current launchd session'
    'managername:print the name of the current launchd session'
    'error:print a description of an error'
    'variant:print the launchd variant'
    'version:print the launchd version'
    'help:print the usage for a given subcommand'
  )
}

__launchctl_services_in() {
  { command launchctl print "$1" 2>/dev/null ||
    command sudo -n launchctl print "$1" 2>/dev/null } |
    awk '/^\tservices = \{/ {f=1; next} /^\t\}/ {f=0} f {print $NF}'
}

__launchctl_labels() {
  command launchctl list 2>/dev/null | awk 'NR>1 {print $3}'
}

__launchctl_uids() {
  dscl . -list /Users UniqueID 2>/dev/null | awk '{print $2 ":" $1}'
}

__launchctl_service_targets() {
  setopt localoptions extendedglob
  local mode=$1 token=$PREFIX uid=$(id -u) domain d s
  local -a services targets domains
  local pat='(system|user/<->|gui/<->|pid/<->|session/<->)'
  [[ $mode == persistent ]] && pat='(system|user/<->|gui/<->)'
  if [[ $token == (#b)(${~pat})/* ]]; then
    domain=$match[1]
    services=(${(f)"$(__launchctl_services_in $domain)"})
    (( $#services )) && compadd -- ${services/#/$domain/}
    return
  fi
  domains=(
    "system/:system-wide domain"
    "user/$uid/:user domain (background services)"
    "gui/$uid/:GUI domain (per-login services)"
  )
  [[ $mode == persistent ]] || domains+=(
    "pid/:process domain (pid/<pid>/)"
    "session/:audit session domain (session/<asid>/)"
  )
  _describe -t domain-prefixes 'launchd domain' domains -S ''
  if [[ -n $token ]]; then
    for d in system user/$uid gui/$uid; do
      for s in ${(f)"$(__launchctl_services_in $d)"}; do
        [[ $s == $token* ]] && targets+=("$d/$s")
      done
    done
    (( $#targets )) && compadd -U -- $targets
  fi
}

__launchctl_domain_targets() {
  local uid=$(id -u)
  local -a bare=(
    "system:system-wide domain"
    "user/$uid:user domain (background services)"
    "gui/$uid:GUI domain (per-login services)"
  )
  local -a open=(
    "pid/:process domain (pid/<pid>)"
    "session/:audit session domain (session/<asid>)"
  )
  _describe -t domains 'launchd domain' bare
  _describe -t domain-prefixes 'launchd domain' open -S ''
}

_launchctl() {
  local -a reply
  if (( CURRENT == 2 )); then
    __launchctl_cmds
    _describe -t subcommands 'launchctl subcommand' reply
    return
  fi
  local sub=$words[2] prev=$words[CURRENT-1]
  local -a mid=(${(M)words[3,CURRENT-1]:#[^-]*})
  local n=$#mid
  local -a labels uids
  case $sub in
    enable|disable)
      (( n == 0 )) && __launchctl_service_targets persistent
      ;;
    blame|print)
      (( n == 0 )) && __launchctl_service_targets all
      ;;
    kickstart)
      if [[ $PREFIX == -* ]]; then
        compadd -- -k -p -s
      elif (( n == 0 )); then
        __launchctl_service_targets all
      fi
      ;;
    attach)
      if [[ $PREFIX == -* ]]; then
        compadd -- -k -s -x
      elif (( n == 0 )); then
        __launchctl_service_targets all
      fi
      ;;
    bootout)
      if [[ $PREFIX == -* ]]; then
        compadd -- --wait
      elif (( n == 0 )); then
        __launchctl_service_targets all
      else
        _files
      fi
      ;;
    debug)
      if (( n == 0 )); then
        __launchctl_service_targets all
      else
        compadd -- --program --start-suspended --guard-malloc \
          --malloc-stack-logging --malloc-nano-allocator --debug-libraries \
          --NSZombie --32 --stdin --stdout --stderr --environment
      fi
      ;;
    kill)
      if (( n == 0 )); then
        compadd -- SIGHUP SIGINT SIGQUIT SIGILL SIGTRAP SIGABRT SIGEMT SIGFPE \
          SIGKILL SIGBUS SIGSEGV SIGSYS SIGPIPE SIGALRM SIGTERM SIGURG SIGSTOP \
          SIGTSTP SIGCONT SIGCHLD SIGTTIN SIGTTOU SIGIO SIGXCPU SIGXFSZ \
          SIGVTALRM SIGPROF SIGWINCH SIGINFO SIGUSR1 SIGUSR2
      elif (( n == 1 )); then
        __launchctl_service_targets all
      fi
      ;;
    bootstrap)
      if (( n == 0 )); then
        __launchctl_domain_targets
      else
        _files
      fi
      ;;
    print-disabled)
      (( n == 0 )) && __launchctl_domain_targets
      ;;
    plist)
      _files
      ;;
    limit)
      (( n == 0 )) && compadd -- cpu filesize data stack core rss memlock maxproc maxfiles
      ;;
    examine)
      if (( n == 0 )); then
        _command_names -e
      else
        _files
      fi
      ;;
    config)
      case $n in
        0)
          local -a cfg=(
            'system:persistent system configuration'
            'user:persistent user configuration'
          )
          _describe -t config-domains 'configuration domain' cfg
          ;;
        1)
          local -a params=(
            'umask:set the umask for services in the domain'
            'path:set the PATH for services in the domain'
          )
          _describe -t config-params 'parameter' params
          ;;
      esac
      ;;
    reboot)
      if [[ $PREFIX == -* ]]; then
        compadd -- -s
      elif (( n == 0 )); then
        local -a types=(
          'system:full system reboot'
          'halt:halt without rebooting'
          'userspace:re-exec launchd and bring userspace back up'
          'logout:tear down the GUI login session'
          'apps:terminate non-launchd apps in the session'
        )
        _describe -t reboot-types 'reboot type' types
      fi
      ;;
    error)
      (( n == 0 )) && compadd -- posix mach bootstrap
      ;;
    load|unload)
      case $prev in
        -S) compadd -- Aqua Background LoginWindow System ;;
        -D) compadd -- system local user ;;
        *)
          if [[ $PREFIX == -* ]]; then
            compadd -- -w -F -S -D
          else
            _files
          fi
          ;;
      esac
      ;;
    start|stop|remove|list)
      labels=(${(f)"$(__launchctl_labels)"})
      (( n == 0 && $#labels )) && compadd -- $labels
      ;;
    submit)
      case $prev in
        -p|-o|-e) _files ;;
        -l) ;;
        *)
          if [[ $PREFIX == -* ]]; then
            compadd -- -l -p -o -e
          else
            _files
          fi
          ;;
      esac
      ;;
    asuser)
      if (( n == 0 )); then
        uids=(${(f)"$(__launchctl_uids)"})
        _describe -t uids 'uid' uids
      elif (( n == 1 )); then
        _command_names -e
      else
        _files
      fi
      ;;
    bsexec)
      if (( n == 1 )); then
        _command_names -e
      elif (( n > 1 )); then
        _files
      fi
      ;;
    help)
      __launchctl_cmds
      _describe -t subcommands 'launchctl subcommand' reply
      ;;
  esac
}

(( $+functions[compdef] )) && _launchctl "$@"
