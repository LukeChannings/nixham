{
  lib,
  path,
  runCommand,
  writeText,
  nixosOptionsDoc,
  nixos-render-docs,
  documentation-highlighter,
  treefmt,
  treefmtConfig,
  nixham,
  revision ? null,
}:
let
  inherit (lib) concatMapStrings hasPrefix removePrefix;

  root = toString ../..;
  relative = decl: removePrefix "${root}/" (toString decl);

  inherit
    (nixham.inputs.nix-darwin.lib.darwinSystem {
      modules = [
        nixham.darwinModules.default
        { nixpkgs.hostPlatform = "aarch64-darwin"; }
      ];
    })
    options
    ;

  # flake-parts wraps the exported modules, hiding their _file.
  modules =
    lib.mapAttrsToList
      (name: module: rec {
        inherit name;
        id = "nix-darwin-${name}";
        dir = dirOf (relative module._file);
        file = "nix-darwin/${name}.md";
      })
      (lib.filterAttrs (_: module: module ? _file) (import ../../modules/nix-darwin { inherit nixham; }));

  optionsDoc =
    module: url:
    nixosOptionsDoc {
      inherit options;
      transformOptions =
        opt:
        let
          declarations = lib.filter (decl: hasPrefix "${module.dir}/" (relative decl)) opt.declarations;
          upstream = lib.any (decl: !hasPrefix "${root}/" (toString decl)) opt.declarations;
        in
        opt
        // {
          visible = opt.visible && declarations != [ ] && !upstream;
          declarations = map (decl: {
            url = url (relative decl);
            name = "<nixham/${relative decl}>";
          }) declarations;
        };
    };

  # For modules whose options' longest shared path isn't their namespace.
  namespaces = {
    launchd-logging = "launchd.logging";
    launchd-wait4path = "launchd.*.waitForPaths";
    oci-containers = "virtualisation.oci-containers";
    zsh = "programs.zsh";
  };
  namespace =
    m:
    let
      locs = map (opt: opt.loc) (lib.attrValues (optionsDoc m forgeUrl).optionsNix);
    in
    namespaces.${m.name}
      or (lib.concatStringsSep "." (lib.foldl' lib.lists.commonPrefix (lib.head locs) locs));

  rev = if revision == null then "main" else revision;
  forgeUrl =
    file:
    "https://forge.channings.me/hartlandia/nixham/src/${
      if revision == null then "branch" else "commit"
    }/${rev}/${file}";

  generated = "<!-- Generated by `just docs`. Do not edit. -->";

  index = writeText "README.md" ''
    ${generated}

    # Module options

    ## nix-darwin

    ${concatMapStrings (m: "- [${namespace m}](${m.file})\n") (lib.sortOn namespace modules)}
  '';

  markdown = runCommand "nixham-options-markdown" { nativeBuildInputs = [ treefmt ]; } ''
    mkdir -p $out/nix-darwin
    cat ${index} > $out/README.md
    ${concatMapStrings (m: ''
      {
        echo ${lib.escapeShellArg generated}
        echo
        echo "# ${m.name}"
        echo
        cat ${(optionsDoc m (file: "../../../${file}")).optionsCommonMark}
      } > $out/${m.file}
    '') modules}
    treefmt --config-file ${treefmtConfig} --tree-root $out --no-cache
  '';

  chapter =
    m:
    writeText "${m.name}.md" ''
      # nix-darwin: ${m.name} {#ch-${m.id}}

      ```{=include=} options
      id-prefix: opt-
      list-id: ${m.id}-options
      source: ${(optionsDoc m forgeUrl).optionsJSON}/share/doc/nixos/options.json
      ```
    '';

  manual = writeText "manual.md" ''
    # Nixham module options {#book-nixham}
    ## Revision ${rev}

    ```{=include=} chapters
    ${concatMapStrings (m: "${m.file}\n") modules}```
  '';
in
runCommand "nixham-manual-html"
  {
    nativeBuildInputs = [ nixos-render-docs ];
    passthru = { inherit markdown; };
    meta.description = "HTML manual of nixham's module options";
  }
  ''
    dst=$out/share/doc/nixham
    mkdir -p $dst
    cp ${path}/doc/style.css $dst
    cp -r ${documentation-highlighter} $dst/highlightjs
    mkdir nix-darwin
    cp ${manual} manual.md
    ${concatMapStrings (m: "cp ${chapter m} ${m.file}\n") modules}
    nixos-render-docs -j $NIX_BUILD_CORES manual html \
      --manpage-urls ${writeText "manpage-urls.json" "{}"} \
      --revision ${lib.escapeShellArg rev} \
      --stylesheet style.css \
      --stylesheet highlightjs/mono-blue.css \
      --script ./highlightjs/highlight.pack.js \
      --script ./highlightjs/loader.js \
      manual.md \
      $dst/index.html
  ''
