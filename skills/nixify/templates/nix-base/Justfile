# List available recipes
default:
    @just --list

# Format the tree
format:
    treefmt

alias fmt := format

# Check the working tree directly (no store copy). The flake's
# checks.formatting output exists for CI, where a store copy is acceptable.
check:
    treefmt --ci

alias lint := check

# If the project distinguishes unit and integration tests, split into
# `test-unit` and `test-integration` recipes and make `test` run both:
#   test: test-unit test-integration

# Run the test suite
test:
    @echo 'CHANGEME: wire up the test runner' >&2; exit 1

# Build the default package
build:
    nix-build -A default

# Run the default package (set the binary name once packages.default exists)
run *ARGS: build
    ./result/bin/CHANGEME {{ ARGS }}

alias start := run

# Regenerate .zed/tasks.json so Zed's task runner mirrors this Justfile.
# Re-run after adding or renaming recipes.
zed-tasks:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p .zed
    {
      echo '['
      sep=''
      for recipe in $(just --summary); do
        printf '%b  { "label": "just %s", "command": "just", "args": ["%s"] }' "$sep" "$recipe" "$recipe"
        sep=',\n'
      done
      printf '\n]\n'
    } > .zed/tasks.json
    echo "wrote .zed/tasks.json ($(just --summary | wc -w | tr -d ' ') tasks)"

# Create a git worktree under .worktree/<issue>-<slug> on a matching branch
# and prime direnv in it
worktree issue slug:
    git worktree add .worktree/{{ issue }}-{{ slug }} -b {{ issue }}-{{ slug }}
    just init-worktree .worktree/{{ issue }}-{{ slug }}

# Prime direnv in a freshly created worktree (or any new checkout)
init-worktree dir=".":
    cd {{ dir }} && direnv allow && direnv reload
